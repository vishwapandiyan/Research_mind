# Optional — override defaults via environment variables.
# Copy to .env and fill in values. Never commit .env.

# LLM provider: ollama | openai | anthropic (default: ollama)
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# API keys — can also be set at runtime via the extension popup
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Brave Search (optional — enables web search for gap-filling)
# BRAVE_API_KEY=...
